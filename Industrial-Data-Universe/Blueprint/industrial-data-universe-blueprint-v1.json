  "id_conventions": {
    "material": "<FAMILY>-<6-digit sequence>",
    "production_order": "PO-<YYYY>-<8-digit sequence>",
    "inspection_lot": "IL-<ORIGIN>-<YYYY>-<8-digit sequence>",
    "mes_event": "EVT-<UTC timestamp>-<sequence>",
    "work_center": "WC-<PLANT>-<AREA>-<NN>",
    "mes_resource": "RES-<PLANT>-<AREA>-<NNN>"
  },
  "temporal_rules": [
    "Master data valid before dependent transaction date",
    "Production order refers to a valid production version",
    "Confirmation timestamp is after operation start",
    "Goods receipt occurs after or together with permitted confirmation logic",
    "Inspection lot creation depends on the approved inspection scenario",
    "MES events preserve causal order and use idempotency keys"
  ],
  "quality_gates": [
    "No duplicate primary keys",
    "No orphan foreign keys",
    "No required field is blank",
    "All values respect HANA target lengths",
    "All valid files pass validation before import",
    "Invalid packages fail for the intended reason only",
    "Record counts and checksums are written to the manifest"
  ],
  "future_event_catalog": [
    "ORDER_RELEASED",
    "OPERATION_STARTED",
    "QUANTITY_CONFIRMED",
    "SCRAP_REPORTED",
    "DOWNTIME_STARTED",
